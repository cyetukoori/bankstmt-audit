// =============================================================================
//  SEED pipeline — regenerates this repo's Jenkins jobs from jenkins/jobs.groovy.
//
//  This is the ONLY job created by hand. Everything else (unit / deploy /
//  release-develop / release-main) is generated by the Job DSL script it runs.
//  Re-run it after any change to jenkins/jobs.groovy to create/update/delete
//  jobs to match.
//
//  One-time bootstrap (see jenkins/README.md):
//    New Item -> Pipeline -> "Pipeline script from SCM" -> this repo ->
//    Script Path = Jenkinsfile.seed. Requires the "Job DSL" plugin.
// =============================================================================

pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
    timeout(time: 10, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  parameters {
    string(
      name: 'SEED_BRANCH',
      defaultValue: '',
      description: 'Branch the GENERATED jobs should build (e.g. develop). Blank = track the same branch this seed run used.')
    string(
      name: 'SEED_CREDENTIALS_ID',
      defaultValue: '',
      description: 'Jenkins credentials id for cloning the repo (SSH key or token). Leave blank if the agent already has git access.')
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Generate jobs') {
      steps {
        script {
          def repoUrl = scm.userRemoteConfigs[0].url
          def rawBranch = params.SEED_BRANCH?.trim()
          if (!rawBranch) {
            rawBranch = (env.GIT_BRANCH ?: 'develop').replaceFirst(/^[^\/]+\//, '')
          }
          echo "Seeding jobs: repo=${repoUrl} branch=${rawBranch} credentials='${params.SEED_CREDENTIALS_ID}'"

          withEnv([
            "SEED_REPO_URL=${repoUrl}",
            "SEED_BRANCH=*/${rawBranch}",
            "SEED_CREDENTIALS_ID=${params.SEED_CREDENTIALS_ID}",
          ]) {
            jobDsl(
              targets: 'jenkins/jobs.groovy',
              removedJobAction: 'DELETE',
              removedViewAction: 'DELETE',
              lookupStrategy: 'SEED_JOB',
              sandbox: true,
            )
          }
        }
      }
    }
  }

  post {
    success { echo 'Seed complete — jobs now match jenkins/jobs.groovy.' }
    failure { echo 'Seed FAILED — jobs were not changed. Check the Job DSL error above (a script-security approval may be required on first run).' }
  }
}
