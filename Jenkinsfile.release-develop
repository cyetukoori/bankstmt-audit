// =============================================================================
//  AUDIT — DEVELOP RELEASE GATE.
//
//  The release criterion: the test set must pass first. This pipeline runs
//  develop's tests (unit) fail-fast, and only if green does it trigger the
//  deploy job (which builds the jar and rolls the Elastic Beanstalk env).
//
//  Pinned to the develop branch by its Job DSL definition (jenkins/jobs.groovy),
//  so it always gates the exact source being released.
// =============================================================================

pipeline {
  agent any

  options {
    disableConcurrentBuilds()
    timestamps()
    timeout(time: 30, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  parameters {
    string(
      name: 'DEPLOY_JOB',
      defaultValue: 'deploy',
      description: 'Downstream job to trigger once the gate is green (relative to this folder). Blank = gate only, no release.')
  }

  environment {
    GRADLE_OPTS = '-Dorg.gradle.daemon=false -Dorg.gradle.jvmargs=-Xmx2g'
  }

  stages {
    stage('Preflight') {
      steps {
        sh '''
          set -euo pipefail
          command -v java >/dev/null || { echo "java missing — JDK 25 required"; exit 1; }
          test -x ./gradlew || chmod +x ./gradlew
        '''
      }
    }

    stage('Unit') {
      steps { sh './gradlew test --no-daemon --stacktrace' }
    }

    stage('Release (develop)') {
      when { expression { params.DEPLOY_JOB?.trim() } }
      steps {
        echo "All develop tests passed — releasing via '${params.DEPLOY_JOB}'."
        build job: params.DEPLOY_JOB, wait: true, propagate: true
      }
    }
  }

  post {
    always { junit testResults: '**/build/test-results/test/*.xml', allowEmptyResults: true }
    success { echo 'DEVELOP GATE PASSED — tests green; release done (or gate-only if DEPLOY_JOB was blank).' }
    failure { echo 'DEVELOP GATE FAILED — nothing released.' }
  }
}
