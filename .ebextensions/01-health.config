# Point the Elastic Beanstalk load balancer health check at the Spring Boot actuator health
# endpoint instead of "/", which the audit service (a background consumer) does not serve.
option_settings:
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /actuator/health
    Port: '80'
    Protocol: HTTP
    MatcherHTTPCode: '200'
  aws:elasticbeanstalk:application:
    Application Healthcheck URL: /actuator/health
